      "temperature_offset": {"name": "Temperature offset"},
      "humidity_offset": {"name": "Humidity offset"},
      "co2_offset": {"name": "CO₂ offset"},
      "pm25_offset": {"name": "PM2.5 offset"},
      "pm10_offset": {"name": "PM10 offset"},
      "power_off_time": {"name": "Power-off time"},
      "display_off_time": {"name": "Display-off time"},
      "auto_slideing_time": {"name": "Screen saver start delay"},
      "timezone": {"name": "Time zone"}
    },
    "select": {
      "screensaver_type": {"name": "Screen mode"},
      "temperature_unit": {"name": "Display temperature unit"},
      "clock_format": {"name": "Clock format"}
    },
    "switch": {"co2_asc": {"name": "CO₂ automatic calibration"}},
    "time": {
      "night_mode_start_time": {"name": "Night mode start"},
      "night_mode_end_time": {"name": "Night mode end"}
    },
    "update": {
      "firmware": {"name": "Firmware"}
