{
  "title": "Qingping Air Monitor Lite",
  "config": {
    "step": {
      "user": {
        "title": "Add Qingping Air Monitor Lite",
        "description": "The device must already be paired with Home Assistant through HomeKit Device.",
        "data": {
          "name": "Name",
          "mac": "MAC address",
          "homekit_pairing_id": "HomeKit pairing ID (optional)",
          "qingping_app_secret": "Qingping App signing key"
        },
        "data_description": {
          "qingping_app_secret": "Private signing key obtained from your own Qingping App installation; it is not included with this integration."
        }
      },
      "reconfigure": {
        "title": "Update Qingping App signing key",
        "data": {
          "qingping_app_secret": "Qingping App signing key"
        }
      }
    },
    "error": {
      "invalid_mac": "Enter a valid 12-digit hexadecimal MAC address.",
      "invalid_app_secret": "Enter a non-empty Qingping App signing key."
    },
    "abort": {
      "reconfigure_successful": "The Qingping App signing key was updated."
    }
  },
  "entity": {
